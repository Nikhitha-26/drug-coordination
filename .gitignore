cat > .gitignore <<'EOF'
# macOS files
.DS_Store

# AWS SAM generated files
backend/.aws-sam/

# Python cache and test output
__pycache__/
.pytest_cache/
*.py[cod]

# Virtual environments
backend/.venv/
backend/.venv-1/
backend/venv/

# Local secrets
backend/.env
backend/.env.*
!backend/.env.example

# Frontend generated files
frontend/node_modules/
frontend/dist/
EOF
.env
.env.*
!.env.example
.venv/
venv/
node_modules/
__pycache__/
.DS_Store
*.zip
.pytest_cache/